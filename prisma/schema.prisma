// Safa Kurtilab Database Schema — v2.0 (B2B Taxonomy + Extended Product Metadata)
// SQLite for local dev; automatically switched to PostgreSQL for Vercel production via vercel-prebuild.js

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────
// USER MODEL
// ─────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  role      String   @default("USER") // USER | ADMIN — String for SQLite/Postgres compatibility
  orders    Order[]
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// PRODUCT MODEL — Full B2B Taxonomy + Dimensions + Financial Data
// ─────────────────────────────────────────────
model Product {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String
  basePrice   Float                            // Legacy retail base price
  discount    Float     @default(0)            // Retail discount %
  images      String                           // Comma-separated image URLs (cross-DB compatible)

  // ── Level 1: Sourcing Hub ──────────────────
  hubLocation       String?   // RAJASTHAN_JAIPUR | GUJARAT_SURAT | UTTAR_PRADESH_LUCKNOW
  industrialCluster String?   // Sanganer | Sitapura | Millennium Market | Ahmedabad Kalupur | Chowk

  // ── Level 2 & 3: Fabric & Yarn Specifications ──
  fabricType        String?   // Cotton | Rayon | Georgette | Modal Silk | Pakistani Lawn
  fabricGrade       String?   // PURE_CAMBRIC_6060 | HEAVY_RAYON_14KG | PAKISTANI_LAWN_COTTON_80S | etc.
  yarnSpecGsm       String?   // e.g. "80s x 80s / 90 GSM"

  // ── Level 3: Quality Grading ──────────────
  qualityGrade      String?   // GRADE_AAA | GRADE_AA | GRADE_A | GRADE_B

  // ── Level 4: Design & Craftsmanship ───────
  craftTypes        String?   // Comma-separated: "Schiffli Lace,Organza Dupatta,Digital Print"
  patternCut        String?   // PAKISTANI_LONG_PANEL | CO_ORD_SET | SHORT_TUNIC | STRAIGHT_SET | ANARKALI_FLARED | ALIA_CUT | NYRA_CUT

  // ── Product Physical Dimensions ───────────
  topLengthInches   Int?      // e.g. 46 (Pakistani Long Panel) | 30 (Short Tunic) | 42 (Straight Set)
  dupattalengthMeters Float?  // e.g. 2.25 | 2.5 | null (if no dupatta)

  // ── B2B Pricing Structure ─────────────────
  supplierSku       String?   @unique  // e.g. SKL-SRT-PAK80-PKP-0001
  exFactoryPrice    Float?             // Raw cost from manufacturer (per set)
  b2bSetPrice       Float?             // Wholesale selling price (per 4-piece set)
  perPiecePrice     Float?             // Derived: b2bSetPrice / setPcs
  msrpRetailPrice   Float?             // Suggested end-consumer price (per piece)
  retailerMarginPct Float?             // Derived: ((msrp - perPiece) / perPiece) * 100
  gstRatePercent    Int       @default(5)  // GST rate for garments (5%)
  microCostingJson  String?            // JSON: { fabric, print, stitching, craft, packaging }

  // ── B2B Set & Bundle Configuration ────────
  setPcs            Int       @default(4)                    // 4 = M,L,XL,XXL | 6 = S,M,L,XL,XXL,3XL
  setRatio          String    @default("M,L,XL,XXL")        // Comma-separated sizes in bundle
  isPlusSize        Boolean   @default(false)                // True if bundle contains 3XL+
  videoUrl          String?                                   // Product video URL (optional)

  // ── Level 5: Smart Discovery & Taxonomy Tags ──
  collectionTags    String?   // Comma-separated: "PAKISTANI_SUITS,CO_ORD_SETS,DAILYWEAR_BUDGET,PLUS_SIZE_SPECIAL"
  isBestseller      Boolean   @default(false)
  isNewArrival      Boolean   @default(true)
  isHighMargin      Boolean   @default(false)

  // ── Legacy Category Field ─────────────────
  category          String    // Kurti Pant Set | Plazo Suit Set (preserve existing front-end filters)

  variants          Variant[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
}

// ─────────────────────────────────────────────
// VARIANT MODEL — Size & Color Inventory Control
// ─────────────────────────────────────────────
model Variant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String   // M | L | XL | XXL | 3XL (for plus size bundles)
  color     String   // Assorted | Emerald | Mustard Gold | Crimson
  stock     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([productId, size, color])
}

// ─────────────────────────────────────────────
// ORDER MODEL — B2B GST + Logistics Engine
// ─────────────────────────────────────────────
model Order {
  id             String  @id @default(cuid())
  userId         String
  user           User    @relation(fields: [userId], references: [id])
  items          String  // JSON snapshot array of ordered items with sizes and B2B prices
  totalAmount    Float
  gstAmount      Float   // 5% GST computed at checkout
  gstin          String? // B2B GSTIN (optional)
  companyName    String? // B2B company name (optional)
  paymentStatus  String  // PENDING | PAID | FAILED
  deliveryStatus String  // PROCESSING | SHIPPED | DELIVERED
  trackingId     String? // 3PL Tracking ID (Shiprocket/Delhivery)
  invoiceData    String? // JSON: HSN 6208, CGST, SGST, IGST tax breakdown
  phone          String?
  address        String?
  city           String?
  state          String? // Determines CGST/SGST vs IGST routing
  pincode        String?
  createdAt      DateTime @default(now())
}
